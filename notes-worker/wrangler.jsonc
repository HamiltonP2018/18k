// Servidor de las notitas compartidas (ver README.md de esta carpeta).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notitas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "NotesRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotesRoom"] }]
}
